{
  "name": "@acme/orders-api",
  "version": "2.3.1",
  "description": "REST API for the orders service",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "orders-cli": "./bin/cli.js"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "files": ["dist", "bin"],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "~8.16.0",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "pino": ">=9"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.0"
  },
  "overrides": {
    "qs": "6.14.0"
  },
  "workspaces": ["packages/*"]
}
